# Escape literal `$` characters as `$$` when using Docker Compose env files.

# Required ClickUp API access
CLICKUP_API_TOKEN=pk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLICKUP_TEAM_ID=123456

# Required MCP client auth
CLICKUP_MCP_API_KEY=change-me

# Google sign-in for MCP clients (see docs/mcp-oauth.md). Keep CLICKUP_API_TOKEN.
# MCP_AUTH_MODE=google-oauth
# MCP_OAUTH_GOOGLE_CLIENT_ID=your-google-web-client-id
# MCP_OAUTH_GOOGLE_CLIENT_SECRET=your-google-web-client-secret
# MCP_OAUTH_BASE_URL=https://clickup-mcp.example.com
# MCP_OAUTH_SIGNING_KEY=generate-a-stable-random-secret-of-at-least-32-characters
# MCP_OAUTH_ALLOWED_EMAILS=you@example.com

# Optional generic aliases
# MCP_API_KEY=change-me
# MCP_API_KEYS=key-one,key-two

# Optional endpoint overrides
# CLICKUP_MCP_PORT=3004
# CLICKUP_MCP_HOST_PORT=3004
# CLICKUP_MCP_PATH=/mcp

# Optional write controls
# WRITE_MODE=selective
# WRITE_ALLOWED_SPACES=12345,67890
# WRITE_ALLOWED_LISTS=111,222

# Optional runtime tuning
# CHAR_LIMIT=16000
# MAX_ATTACHMENT_MB=8
# REPORTING_MAX_TASKS=200
# DEFAULT_RISK_WINDOW_DAYS=5
# API_KEY_MODE=disabled

# Optional live smoke harness targeting
# CLICKUP_LIVE_SMOKE_SPACE_ID=123456
# CLICKUP_LIVE_SMOKE_DOC_ID=abcdef12-3456-7890-abcd-ef1234567890
